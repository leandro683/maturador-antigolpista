# =====================================================================
# Maturador + Anti-golpista: variáveis de ambiente (MODELO).
# Copie para `.env` e preencha. NUNCA publique valores reais.
# Segredos: docker run --rm node:22-slim node -p "require('crypto').randomBytes(32).toString('hex')"
# Com o Docker Compose, passe sempre o arquivo: docker compose --env-file .env -f infra/docker-compose.yml ...
# =====================================================================

# ---------- Painel ----------
# Endereço público do painel. Com https:// o cookie de sessão sai com a marca Secure; abra o painel pelo mesmo endereço.
APP_URL=http://localhost:3100
# Fuso do agendador (a análise automática diária do anti-golpista roda às 3h07 nesse fuso).
APP_TZ=America/Sao_Paulo
# Porta do painel no Docker Compose, publicada só em 127.0.0.1.
WEB_PORT=3100

# ---------- Banco e fila ----------
# Senha do Postgres do Docker Compose (obrigatória). Só letras e números: não use @ : / ? #
POSTGRES_PASSWORD=
# Postgres (schema `mag`). O Docker Compose NÃO usa este valor: ele monta o endereço com o serviço `postgres`.
# Vale fora do Docker (desenvolvimento) e para rodar as migrações à mão.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Redis das filas. O Docker Compose NÃO usa este valor (usa o serviço `redis`). Vale fora do Docker.
REDIS_URL=redis://127.0.0.1:6379

# ---------- WAHA (a ponte com o WhatsApp, motor GOWS) ----------
# Endereço do WAHA. O Docker Compose NÃO usa este valor (usa o serviço `waha`). Vale fora do Docker.
WAHA_URL=http://127.0.0.1:3001
# Chave da API do WAHA (obrigatória no Docker Compose; vai no cabeçalho X-Api-Key).
WAHA_API_KEY=
# Segredo que assina os avisos do WAHA para o painel (obrigatório; cabeçalho X-Webhook-Hmac, sha512).
WAHA_HOOK_HMAC_KEY=
# 1 = motor de mentira: nada sai para o WhatsApp. Só para desenvolvimento e testes, fora do Docker Compose.
# As sessões ficam na memória de cada processo (painel e worker): reiniciar perde as sessões.
WA_FAKE_ENGINE=
# Imagem do WAHA no Docker Compose. O maturador precisa de pelo menos duas sessões; quantas o WAHA aceita depende da edição e da versão.
WAHA_IMAGE=devlikeapro/waha:gows
# Só para depuração: porta do WAHA em 127.0.0.1, usada apenas com infra/docker-compose.waha-debug.yml.
WAHA_PORT=3001

# ---------- Login do painel ----------
# password = e-mail e senha do administrador; supabase = login pelo Supabase.
AUTH_MODE=password
# Modo password: e-mail do administrador.
ADMIN_EMAIL=alguem@example.com
# Modo password: senha do administrador (mínimo de 10 caracteres).
ADMIN_PASSWORD=
# Modo password: segredo que assina a sessão (mínimo de 32 caracteres). O Docker Compose não sabe exigir só no modo
# password: no modo supabase você TAMBÉM precisa preencher (qualquer valor de 32 caracteres; ele não é usado).
SESSION_SECRET=
# Deixe vazio sem proxy reverso: o limite de tentativas de login (e da página pública) vira um só para todos.
# Use 1 só atrás de um proxy que SOBRESCREVE o cabeçalho X-Forwarded-For com o IP real do visitante.
TRUST_PROXY=
# Modo supabase: endereço do projeto, chave pública (anon) e e-mails de administrador separados por vírgula.
# As duas primeiras entram no painel na hora de montar a imagem: mudou, rode o `up` com --build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAILS=

# ---------- Maturador (conversas geradas por IA) ----------
# Chave da OpenRouter. Vazia: o maturador não gera conversas.
OPENROUTER_API_KEY=
# Chave só do maturador (opcional; sem ela vale OPENROUTER_API_KEY). O Docker Compose repassa ao worker.
# OPENROUTER_API_KEY_MATURADOR=
# Tempo máximo de uma chamada à IA, em milissegundos (padrão 120000). O Docker Compose repassa ao worker.
# LLM_TIMEOUT_MS=120000

# ---------- Opções avançadas do Docker Compose (valores comentados já são os padrões) ----------
# Motor do WAHA para novas sessões.
# WHATSAPP_DEFAULT_ENGINE=GOWS
# Nomes das imagens montadas (painel e worker).
# WEB_IMAGE=mag/web:latest
# WORKER_IMAGE=mag/worker:latest
# Portas do Compose de desenvolvimento (infra/docker-compose.dev.yml), só em 127.0.0.1.
# POSTGRES_PORT=5544
# REDIS_PORT=6399

# ---------- Só para desenvolvimento ----------
# Postgres usado pelos testes (o Compose de desenvolvimento publica 127.0.0.1:5544).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/postgres
# Arquivo local com a lista proibida do verificador de dados pessoais (um regex por linha). Nunca fica no repositório.
# LEAK_DENYLIST=
# Lidas pelo pacote de IA mas sem efeito no maturador, que força a OpenRouter e escolhe o modelo pelo painel.
# LLM_PROVIDER=openrouter
# LLM_MODEL=
# LLM_MODEL_EXTRACAO=
# Define a saída standalone do painel. A imagem Docker já define; não mexa.
# NEXT_OUTPUT=standalone
